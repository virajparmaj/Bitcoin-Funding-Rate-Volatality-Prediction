# ===========================================
# Secrets and credentials
# ===========================================
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ===========================================
# AI assistant / agent artefacts
# ===========================================
# Local tool configuration and session state. These are personal to whoever ran the
# tool and must not reach a shared branch.
.claude/
CLAUDE.md
CLAUDE.local.md
.codex/
CODEX.md
CODEX.local.md
AGENTS.md
AGENTS.local.md
.mcp.json
.cursor/
.cursorrules
.cursorignore
.windsurfrules
.aider*
.continue/
.codeium/
.gemini/
.github/copilot-instructions.md

# Prompts, build briefs, and agent working notes
*_PROMPT.md
*_prompt.md
prompts/
.agent/
.agents/
.agent.md
AGENT.md
scratchpad/
.scratch/
AI_USAGE*
ai_usage*
*_AI_USAGE*
*_ai_usage*

# ===========================================
# Logs and run output
# ===========================================
logs/
*.log

# ===========================================
# Data and generated artefacts
# ===========================================
# NOTE: `data/` and `notes/` are intentionally unanchored, so they match at any depth
# (this is also what keeps v2/data out of the repo). Files tracked before these rules
# existed — e.g. data/normalized_datasets/binance_btc_perp.csv — remain tracked;
# .gitignore only affects untracked files.
data/
notes/
datasets

# ===========================================
# Python
# ===========================================
__pycache__
*.py[cod]
venv
.venv
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# ===========================================
# Editor and OS
# ===========================================
# Was previously written as `models.DS_Store`, which matched only a literal file of
# that name — so .DS_Store was never actually ignored. models/ is tracked and must
# stay tracked, so the two entries are separated correctly here.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local research drafting and exploratory evidence (published study artifacts stay tracked).
/v2/paper_plan/
/v2/paper_package/
/v2/research/research_assessment.md
/v2/research/*.png
# Superseded configs from an interrupted attempt, not the completed v2.1 protocol.
/v2/configs/settlement_study_v2.json
/v2/configs/settlement_study_v2_reproduction.json
# Personal placeholder workspace, not project source.
/vparmaj2/

# Additional local tooling and temporary files.
node_modules/
*_env/
.firecrawl/
.playwright-mcp/
playwright-report/
test-results/
*.tmp
*~
